# Application
APP_NAME=ai-knowledge-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (schema and tables are managed externally; see ../db.sql)
# NOTE: DB_NAME is the DATABASE name; `ai_assistant` is the SCHEMA inside it.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me

# Connection pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5

# Uploads
STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=50

# Chunking (characters, ≈4 chars/token)
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# Embeddings
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional proxy/gateway
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# Max concurrent ingestion jobs
INGESTION_MAX_CONCURRENT=2
